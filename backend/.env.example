# Copy to backend/.env for local development. Replace every placeholder.
# Never commit real secrets or reuse these sample values in production.

NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clinicflow
REDIS_URL=redis://localhost:6379
DISABLE_REDIS=false
DISABLE_WORKER=false

# Generate independent random values; do not use the placeholders below.
JWT_SECRET=replace-with-random-secret
REFRESH_TOKEN_SECRET=replace-with-a-different-random-secret
DB_ENCRYPTION_KEY=replace-with-random-encryption-key
FRONTEND_URL=http://localhost:5173
BACKEND_API_URL=http://localhost:4000

# Public booking protection (use matching Google reCAPTCHA v3 site/secret keys).
RECAPTCHA_SECRET_KEY=
RECAPTCHA_ALLOWED_HOSTNAMES=localhost,127.0.0.1
RECAPTCHA_MIN_SCORE=0.5

# Email (optional locally; required for production password-reset/demo emails).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SALES_NOTIFY_EMAIL=

# AI and voice. Vapi API key is platform-managed; clinic onboarding stores IDs only.
GEMINI_API_KEY=
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_SECRET=
ZADARMA_API_KEY=
ZADARMA_API_SECRET=
ZADARMA_WEBHOOK_SECRET=

# SMS and workflow automation.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_ALPHA_SENDER_ID=
TWILIO_MESSAGING_SERVICE_SID=
N8N_WEBHOOK_URL=
WEBHOOK_SECRET=
AUTOMATION_API_KEY=
MBAS_SYSTEM_SECRET=

# Optional integrations.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_SCALE_MONTHLY=
SENTRY_BACKEND_DSN=
